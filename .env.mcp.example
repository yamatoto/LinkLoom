# Google OAuth設定（MCPテスト用モック）
# Chrome DevTools MCPテスト用の固定値
NEXT_PUBLIC_GOOGLE_CLIENT_ID=mock-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-client-secret

# NextAuth設定
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=mock-nextauth-secret-for-testing

# 表示モード: mcp（Chrome DevTools MCPテスト用の固定表示）
NEXT_PUBLIC_OAUTH_MODE=mcp

# Supabase設定
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
