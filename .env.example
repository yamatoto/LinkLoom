# Google OAuth設定
# Google Cloud Console（https://console.cloud.google.com/）から認証情報を取得してください
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-real-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-real-client-secret

# NextAuth設定
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# 表示モード: production（実際のOAuth）| mcp（テスト用固定表示）
NEXT_PUBLIC_OAUTH_MODE=production

# Supabase設定
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
