# Supabase設定
# Supabase Dashboard（https://app.supabase.com/）から認証情報を取得してください
# Google OAuth認証もSupabase Dashboardで設定します（アプリケーション側での設定不要）
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Playwright E2Eテスト用認証情報
# テスト専用のGoogleアカウントを作成して設定してください
# 詳細: tests/README.md の「E2E認証テスト戦略」を参照
PLAYWRIGHT_TEST_GOOGLE_EMAIL=your-test-email@gmail.com
PLAYWRIGHT_TEST_GOOGLE_PASSWORD=your-test-password
